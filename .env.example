DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
# Se usa para firmar tokens publicos anti-bot de /book y /pre-evaluacion.
# En produccion puede omitirse si AUTH_SECRET ya esta configurado; si se define,
# debe ser secreto y vivir solo en Netlify/local .env.
PUBLIC_FORM_SECRET="change-me-public-form-secret"

# Requerido solo para `pnpm test:integration`. Debe apuntar a una Neon branch
# dedicada a testing ("Branch schema only", nunca copiar datos reales) con las
# migraciones ya aplicadas (`DATABASE_URL=<test-url> pnpm db:migrate`).
TEST_DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Requeridos para el formulario publico de pre-evaluacion (envio de email al
# recibir un envio). Crear una cuenta en resend.com.
RESEND_API_KEY="re_xxx"
CLINIC_NOTIFICATION_EMAIL="dra.eris@example.com"
# Remitente de los correos. Mientras no haya un dominio propio verificado en
# Resend, usar "onboarding@resend.dev" (solo entrega a la casilla verificada
# de la cuenta de Resend). Una vez verificado un dominio propio, cambiar a
# algo como "OtoGyn <notificaciones@tudominio.com>".
RESEND_FROM_EMAIL="onboarding@resend.dev"
